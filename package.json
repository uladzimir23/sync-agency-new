{
  "name": "sync-agency-new",
  "homepage": "https://github.io/uladzimir23/sync-agency-new",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:force": "gh-pages -d dist --force",
    "deploy:ci": "npm run build && npm run test:run && npm run lint && gh-pages -d dist",
    "deploy:safe": "git branch backup/deploy-$(date +%Y%m%d-%H%M%S) && npm run deploy",
    "deploy:auto": "npm run build && git add . && git commit -m 'Auto-deploy preparation' && git push origin main && npm run deploy",
    "build:analyze": "npm run build && npx serve dist",
    "clean:build": "rm -rf dist && npm run build",
    "size-check": "npm run build && npx bundlewatch"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.35.0",
    "class-variance-authority": "^0.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^10.18.0",
    "gsap": "^3.13.0",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.294.0",
    "motion": "^12.23.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/gsap": "^1.20.2",
    "@types/node": "^24.9.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "sass": "^1.93.2",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.12"
  }
}
